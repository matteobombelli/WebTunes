[Unit]
Description=WebTunes yt-dlp self-update (in-site importer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=debian
WorkingDirectory=/home/debian/WebTunes
# -U rewrites bin/yt-dlp in place (the dir is app-user-owned).
ExecStart=/home/debian/WebTunes/bin/yt-dlp -U
