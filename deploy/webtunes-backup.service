[Unit]
Description=WebTunes nightly Postgres backup to R2
# The dump runs `docker compose exec` against the postgres container.
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hs
WorkingDirectory=/home/hs/WebTunes
# Invoke node directly: a login shell (`sh -lc`) dies sourcing
# /etc/profile.d/devpkg-helpers.sh, whose dashed function names dash rejects.
# node and docker both live in /usr/bin, which systemd's default PATH covers,
# and the script loads its own .env files.
ExecStart=/usr/bin/node scripts/backup-db-to-r2.mjs
