[Unit]
Description=WebTunes purge of expired public track-share links
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hs
WorkingDirectory=/home/hs/WebTunes
# Invoke node directly: a login shell (`sh -lc`) dies sourcing
# /etc/profile.d/devpkg-helpers.sh, whose dashed function names dash rejects.
ExecStart=/usr/bin/node scripts/purge-expired-shares.mjs
