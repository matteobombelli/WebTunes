# Copy to .env.local and adjust. The defaults below match `docker compose up -d`
# (Postgres + MinIO) and work out of the box for local development.

# Postgres. Password matches docker-compose's default; for a non-default DB
# password set POSTGRES_PASSWORD in a sibling .env (read by docker compose).
DATABASE_URL=postgres://webtunes:webtunes@localhost:5432/webtunes

# Auth.js. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# S3-compatible storage. Defaults target the dev MinIO container.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=webtunes
S3_FORCE_PATH_STYLE=true

# Email. Without RESEND_API_KEY, lib/email.ts logs reset/verification links to
# the server console instead of sending (dev behavior).
RESEND_API_KEY=
EMAIL_FROM=webtunes@localhost

# ListenBrainz token (https://listenbrainz.org/settings/) used server-side to
# batch-map existing artist/title tags to MusicBrainz IDs for Suggested Imports.
# It does not read or submit that ListenBrainz account's listening history.
LISTENBRAINZ_TOKEN=

# AcoustID acoustic-fingerprint recognition (free app key from
# https://acoustid.org/new-application). This is the slow fallback for missing
# tags or a ListenBrainz mapping miss, and can fill MISSING artist/album/art
# without overwriting existing values. Art-only rows use iTunes by tags and do
# not fingerprint. Unset keeps those fast paths working. Requires fpcalc on PATH.
ACOUSTID_API_KEY=

# yt-dlp binary for the in-site importer (lib/import/). Defaults to bin/yt-dlp
# in the repo (gitignored; see deploy/README.md for provisioning + the daily
# self-update timer), falling back to `yt-dlp` on PATH. Needs Python 3.9+ and
# node on PATH (yt-dlp's YouTube JS challenge solver runs on it).
#YT_DLP_PATH=
